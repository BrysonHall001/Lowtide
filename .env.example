# Only needed if you run Lowtide on your own computer. On Render and GitHub,
# these go in the settings screens instead (see README).
APP_PASSWORD=pick-a-password
SECRET_KEY=any-long-random-text
OPENAI_API_KEY=sk-...
RAPIDAPI_KEY=...
DATABASE_URL=postgresql://...
# Optional tuning
# OPENAI_MODEL=gpt-5-mini
# MAX_QUERIES_PER_RUN=5
# MAX_SCREEN_PER_RUN=40
# MAX_DEEP_DIVES_PER_RUN=5
